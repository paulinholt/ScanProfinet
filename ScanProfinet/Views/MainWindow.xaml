<Window x:Class="ScanProfinet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScanProfinet.ViewModels"
        xmlns:views="clr-namespace:ScanProfinet.Views"
        Title="ScanProfinet" Height="780" Width="1300" MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Botão do menu lateral -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="14,11" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontSize="16" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="lbl" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*" MinWidth="620"/>
            <ColumnDefinition Width="288"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Menu lateral ===== -->
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <DockPanel>
                <!-- Marca -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}">
                                <TextBlock Text="⬡" FontSize="19" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ScanProfinet" Foreground="White" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Diagnóstico PROFINET" Foreground="{StaticResource TextOnDarkMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1" Background="#1E2E48" Margin="16,0,16,10"/>

                <!-- Rodapé -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                    <Border Height="1" Background="#1E2E48" Margin="0,0,0,12"/>
                    <TextBlock Text="© 2026 Paulo Leal Taveira" Foreground="{StaticResource TextOnDarkMuted}" FontSize="11"/>
                    <TextBlock Text="Todos os direitos reservados." Foreground="#5B6E8C" FontSize="10.5" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding VersionText}" Foreground="#5B6E8C" FontSize="10.5" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Navegação -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButton}" Content="Scan da rede" Tag="🔍"
                                 IsChecked="{Binding IsScan, Mode=OneWay}" Command="{Binding GoScanCommand}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Comparar redes" Tag="⇄"
                                 IsChecked="{Binding IsCompare, Mode=OneWay}" Command="{Binding GoCompareCommand}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Monitor de rede" Tag="📈"
                                 IsChecked="{Binding IsMonitor, Mode=OneWay}" Command="{Binding GoMonitorCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <Grid Grid.Column="1" TextElement.Foreground="{StaticResource Text}">
            <views:ScanView DataContext="{Binding Scan}"
                            Visibility="{Binding DataContext.IsScan, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <views:CompareView DataContext="{Binding Compare}"
                               Visibility="{Binding DataContext.IsCompare, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <views:MonitorView DataContext="{Binding Monitor}"
                               Visibility="{Binding DataContext.IsMonitor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ===== Painel direito: redes salvas ===== -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1,0,0,0" TextElement.Foreground="{StaticResource Text}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⟳" Style="{StaticResource BtnGhost}"
                                Command="{Binding RefreshSavedCommand}" Padding="8,2" FontSize="14"
                                ToolTip="Atualizar lista"/>
                        <StackPanel>
                            <TextBlock Text="Redes salvas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Duplo clique para consultar" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}" Margin="16,0,16,0"/>

                <!-- Estado vazio -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Top" Margin="18,20,18,0"
                            Visibility="{Binding HasSavedNetworks, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Nenhuma rede salva ainda." Foreground="{StaticResource TextMuted}"
                               FontSize="12.5" TextWrapping="Wrap"/>
                    <TextBlock Text="Escaneie a rede na aba 'Scan da rede' e clique em 'Salvar rede'."
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <ListBox x:Name="SavedList" BorderThickness="0" Background="Transparent" Margin="8,6,8,8"
                         ItemsSource="{Binding SavedNetworks}" SelectedItem="{Binding SelectedSaved}"
                         MouseDoubleClick="SavedList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="8" Padding="12,10" Background="#F8FAFC"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#EFF6FF"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#DBEAFE"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#E0EAFF" CornerRadius="8" Padding="7,1">
                                        <TextBlock Text="{Binding DeviceCount, StringFormat={}{0} disp.}"
                                                   FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                               FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
