<UserControl x:Class="ScanProfinet.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Comparar redes" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                       Text="Compare uma rede salva com a rede atual e descubra o que saiu, entrou ou mudou."/>
        </StackPanel>

        <!-- Controles -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,10,4">
                    <TextBlock Text="Rede de referência:" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12.5" Margin="0,0,8,0"/>
                    <ComboBox Width="280" VerticalAlignment="Center"
                              ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}"
                              DisplayMemberPath="Display"/>
                </StackPanel>

                <Button Content="Excluir" Style="{StaticResource BtnGhost}"
                        Command="{Binding DeleteReferenceCommand}" Margin="0,4,18,4" MinWidth="80"/>
                <Button Content="Escanear rede atual" Style="{StaticResource BtnPrimary}"
                        Command="{Binding ScanNowCommand}" Margin="0,4,10,4" MinWidth="160"/>
                <TextBlock VerticalAlignment="Center" Margin="0,4,14,4" FontSize="12"
                           Foreground="{StaticResource TextMuted}">
                    <Run Text="Atual:"/><Run Text="{Binding CurrentDeviceCount, Mode=OneWay}"/><Run Text=" disp."/>
                </TextBlock>
                <Button Content="Comparar" Style="{StaticResource BtnSuccess}"
                        Command="{Binding CompareCommand}" Margin="0,4,0,4" MinWidth="120"/>
            </WrapPanel>
        </Border>

        <!-- Resumo -->
        <Border Grid.Row="2" Margin="0,0,0,12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Background" Value="#F0FDF4"/>
                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Result.HasDivergences}" Value="True">
                            <Setter Property="Background" Value="#FFF7ED"/>
                            <Setter Property="BorderBrush" Value="#FED7AA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Headline}" FontSize="14.5" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Style="{StaticResource Pill}" Background="#FDE8E8" Margin="0,0,8,0">
                        <TextBlock Foreground="#DC2626" FontWeight="SemiBold" FontSize="12">
                            <Run Text="Saíram: "/><Run Text="{Binding Result.Removed, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#FEF3C7" Margin="0,0,8,0">
                        <TextBlock Foreground="#B45309" FontWeight="SemiBold" FontSize="12">
                            <Run Text="Entraram: "/><Run Text="{Binding Result.Added, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#E0EAFF" Margin="0,0,8,0">
                        <TextBlock Foreground="#2563EB" FontWeight="SemiBold" FontSize="12">
                            <Run Text="Alterados: "/><Run Text="{Binding Result.Changed, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#DCFCE7">
                        <TextBlock Foreground="#16A34A" FontWeight="SemiBold" FontSize="12">
                            <Run Text="OK: "/><Run Text="{Binding Result.Unchanged, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Estado vazio -->
        <Border Grid.Row="3" Style="{StaticResource Card}"
                Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Nenhuma comparação ainda" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="460">
                    <Run Text="1) Escolha a rede de referência salva."/><LineBreak/>
                    <Run Text="2) Escaneie a rede atual."/><LineBreak/>
                    <Run Text="3) Clique em Comparar."/>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="0,14,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
            </StackPanel>
        </Border>

        <!-- Resultado -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource CompareBg}}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Situação" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="White" Margin="4,0"
                                    BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource CompareAccent}}">
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11"
                                           Foreground="{Binding Status, Converter={StaticResource CompareAccent}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="190">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Fabricante" Binding="{Binding Vendor}" Width="120"/>
                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Diferenças" Binding="{Binding DifferencesText}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="#334155"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
