<Window x:Class="ScanProfinet.Views.SnapshotDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rede salva" Width="920" Height="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource Navy}" CornerRadius="8" Padding="18,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="MetaText" Foreground="{StaticResource TextOnDarkMuted}" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Observações -->
        <Border x:Name="NotesCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#334155" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Dispositivos -->
        <DataGrid Grid.Row="2" x:Name="DevicesGrid" Margin="0,12,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome do dispositivo" Binding="{Binding DeviceName}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                <DataGridTextColumn Header="Máscara" Binding="{Binding SubnetMask}" Width="120"/>
                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Fabricante" Binding="{Binding DeviceVendor}" Width="*"/>
                <DataGridTextColumn Header="Função" Binding="{Binding DeviceRole}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rodapé -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Fechar" Style="{StaticResource BtnGhost}" Width="110" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
