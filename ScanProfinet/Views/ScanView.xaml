<UserControl x:Class="ScanProfinet.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Scan da rede PROFINET" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                       Text="Descubra dispositivos via DCP, ajuste IP/nome e salve a rede para comparar depois."/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 1: placa de rede + tempo de escuta -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Placa de rede" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                          ItemsSource="{Binding Interfaces}"
                          SelectedIndex="{Binding SelectedInterfaceIndex}"
                          ItemTemplate="{StaticResource DisplayItemTemplate}"
                          IsEnabled="{Binding IsNpcapAvailable}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Tempo de escuta" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"
                           ToolTip="Tempo que o app aguarda respostas após enviar a descoberta. Redes maiores ou dispositivos lentos: use mais tempo."/>
                <ComboBox Grid.Row="0" Grid.Column="4" Width="92" VerticalAlignment="Center"
                          SelectedValuePath="Tag" SelectedValue="{Binding ScanSeconds}"
                          ToolTip="Tempo que o app aguarda respostas após enviar a descoberta.">
                    <ComboBoxItem Content="2 s" Tag="2"/>
                    <ComboBoxItem Content="3 s" Tag="3"/>
                    <ComboBoxItem Content="5 s" Tag="5"/>
                    <ComboBoxItem Content="8 s" Tag="8"/>
                    <ComboBoxItem Content="12 s" Tag="12"/>
                </ComboBox>

                <!-- Linha 2: ações -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Escanear rede" Style="{StaticResource BtnPrimary}"
                            Command="{Binding ScanNetworkCommand}" IsEnabled="{Binding IsNpcapAvailable}"
                            MinWidth="150"/>
                    <Button Content="Salvar rede" Style="{StaticResource BtnSuccess}"
                            Command="{Binding SaveSnapshotCommand}" IsEnabled="{Binding HasDevices}"
                            Margin="12,0,0,0" MinWidth="130"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso Npcap -->
        <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding IsNpcapAvailable, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Driver Npcap não encontrado" FontWeight="Bold" FontSize="14" Foreground="#92400E"/>
                <TextBlock Foreground="#92400E" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="O scan da rede PROFINET depende do driver Npcap. Instale-o (marque 'WinPcap API-compatible Mode') e reabra o aplicativo. O instalador do ScanProfinet já oferece a instalação automática."/>
            </StackPanel>
        </Border>

        <!-- Conteúdo: grid + filtro -->
        <Grid Grid.Row="3" Visibility="{Binding IsNpcapAvailable, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Filtrar:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                <TextBox Width="260" HorizontalAlignment="Left"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filtra por nome, IP, MAC, fabricante ou função"/>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IpAddress}" Value="0.0.0.0">
                                <Setter Property="ToolTip" Value="Dispositivo sem IP atribuído"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome do dispositivo" Binding="{Binding DeviceName}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130"/>
                    <DataGridTextColumn Header="Máscara" Binding="{Binding SubnetMask}" Width="130"/>
                    <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="130"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fabricante" Binding="{Binding DeviceVendor}" Width="130"/>
                    <DataGridTextColumn Header="Função" Binding="{Binding DeviceRole}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Painel de ação (device selecionado) -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0"
                Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Set IP -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="ATRIBUIR IP" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4" Width="56"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Máscara" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding NewMask, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gateway" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding NewGateway, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Button Content="Aplicar IP" Style="{StaticResource BtnSuccess}" Command="{Binding SetIpCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" Margin="4,0,16,0"/>

                <!-- Set Name -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="ATRIBUIR NOME (DEVICE NAME)" Style="{StaticResource SectionLabel}"/>
                    <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="O nome é convertido para minúsculas (padrão PROFINET)."/>
                    <Button Content="Aplicar nome" Style="{StaticResource BtnPurple}" Command="{Binding SetNameCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6"/>
                </StackPanel>

                <Border Grid.Column="3" Width="1" Background="{StaticResource Border}" Margin="4,0,16,0"/>

                <!-- Blink -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="IDENTIFICAR" Style="{StaticResource SectionLabel}"/>
                    <Button Content="Piscar LED" Style="{StaticResource BtnWarn}" Command="{Binding BlinkDeviceCommand}"
                            Padding="18,10" ToolTip="Pisca o LED do dispositivo para localizá-lo fisicamente"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
