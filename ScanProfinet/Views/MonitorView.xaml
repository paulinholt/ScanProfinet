<UserControl x:Class="ScanProfinet.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Monitor de rede" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                       Text="Ping contínuo dos dispositivos. Registra automaticamente quedas e oscilações (flapping)."/>
        </StackPanel>

        <!-- Controles -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,10,4">
                    <TextBlock Text="Fonte:" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12.5" Margin="0,0,8,0"/>
                    <ComboBox Width="260" VerticalAlignment="Center"
                              ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              ItemTemplate="{StaticResource DisplayItemTemplate}"/>
                </StackPanel>

                <Button Content="Carregar dispositivos" Style="{StaticResource BtnGhost}"
                        Command="{Binding LoadTargetsCommand}" Margin="0,4,18,4" MinWidth="160"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4">
                    <TextBlock Text="Intervalo:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox Width="74" SelectedValuePath="Tag" SelectedValue="{Binding IntervalSeconds}">
                        <ComboBoxItem Content="1 s" Tag="1"/>
                        <ComboBoxItem Content="2 s" Tag="2"/>
                        <ComboBoxItem Content="5 s" Tag="5"/>
                        <ComboBoxItem Content="10 s" Tag="10"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4"
                            ToolTip="Faz re-scan DCP periódico e avisa quando um dispositivo novo entra na rede monitorada.">
                    <CheckBox Content="Detectar novos" IsChecked="{Binding DetectNewDevices}" VerticalAlignment="Center"/>
                    <ComboBox Width="200" Margin="10,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Interfaces}" SelectedIndex="{Binding SelectedScanInterfaceIndex}"
                              ItemTemplate="{StaticResource DisplayItemTemplate}" IsEnabled="{Binding DetectNewDevices}"
                              ToolTip="Placa de rede usada no re-scan"/>
                    <ComboBox Width="78" Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding DetectNewDevices}"
                              SelectedValuePath="Tag" SelectedValue="{Binding RescanSeconds}" ToolTip="Intervalo do re-scan">
                        <ComboBoxItem Content="10 s" Tag="10"/>
                        <ComboBoxItem Content="20 s" Tag="20"/>
                        <ComboBoxItem Content="30 s" Tag="30"/>
                        <ComboBoxItem Content="60 s" Tag="60"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Iniciar" Style="{StaticResource BtnSuccess}"
                        Command="{Binding StartCommand}" Margin="0,4,0,4" MinWidth="100"
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>
                <Button Content="Parar" Style="{StaticResource BtnDanger}"
                        Command="{Binding StopCommand}" Margin="0,4,0,4" MinWidth="100"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- Alvos monitorados -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText}" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" Content="Limpar" Style="{StaticResource BtnGhost}"
                        Command="{Binding ClearSelectionCommand}" Padding="12,5" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Selecionar 50" Style="{StaticResource BtnGhost}"
                        Command="{Binding SelectFirstBatchCommand}" Padding="12,5"
                        ToolTip="Marca os primeiros 50 dispositivos da lista"/>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Targets}" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Mon." Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{Binding State, Converter={StaticResource MonitorBrush}}" Margin="4,0">
                                <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130"/>
                <DataGridTextColumn Header="Latência" Binding="{Binding LatencyText}" Width="90"/>
                <DataGridTextColumn Header="Perda" Binding="{Binding LossText}" Width="80"/>
                <DataGridTextColumn Header="Transições" Binding="{Binding Transitions}" Width="90"/>

                <DataGridTemplateColumn Header="Histórico (latência)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding LatencyHistory}" VerticalAlignment="Bottom" Height="40">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="4" Margin="1,0,0,0" VerticalAlignment="Bottom" CornerRadius="1"
                                                Height="{Binding Converter={StaticResource LatHeight}}"
                                                Background="{Binding Converter={StaticResource LatBrush}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Cabeçalho do log -->
        <DockPanel Grid.Row="3" Margin="0,16,0,8">
            <Button DockPanel.Dock="Right" Content="Limpar histórico" Style="{StaticResource BtnGhost}"
                    Command="{Binding ClearEventsCommand}" Padding="12,6"/>
            <TextBlock Text="Registro de eventos" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Log de eventos -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Events}" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding TimestampText}" Width="130"/>
                <DataGridTemplateColumn Header="Evento" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{Binding EventType, Converter={StaticResource EventBrush}}" Margin="4,0">
                                <TextBlock Text="{Binding EventType}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="180"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130"/>
                <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="#334155"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
