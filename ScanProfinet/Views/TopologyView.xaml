<UserControl x:Class="ScanProfinet.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Topologia da rede" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                       Text="Vizinhança LLDP (via SNMP): quem está ligado em quem, porta a porta. Veja como tabela ou desenho e detecte cabo trocado."/>
        </StackPanel>

        <!-- Card: mapear -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4">
                    <TextBlock Text="Placa de rede" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                    <ComboBox Width="300" VerticalAlignment="Center"
                              ItemsSource="{Binding Interfaces}" SelectedIndex="{Binding SelectedInterfaceIndex}"
                              ItemTemplate="{StaticResource DisplayItemTemplate}" IsEnabled="{Binding IsNpcapAvailable}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4">
                    <TextBlock Text="Tempo de escuta" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                    <ComboBox Width="92" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding ScanSeconds}">
                        <ComboBoxItem Content="3 s" Tag="3"/>
                        <ComboBoxItem Content="5 s" Tag="5"/>
                        <ComboBoxItem Content="8 s" Tag="8"/>
                        <ComboBoxItem Content="12 s" Tag="12"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4"
                            ToolTip="Comunidade SNMP dos dispositivos (padrão 'public'). Mude se a planta usar outra.">
                    <TextBlock Text="Comunidade SNMP" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                    <TextBox Width="120" VerticalAlignment="Center" Text="{Binding SnmpCommunity, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Content="Mapear topologia" Style="{StaticResource BtnPrimary}"
                        Command="{Binding MapCommand}" IsEnabled="{Binding IsNpcapAvailable}" MinWidth="170" Margin="0,4,16,4"/>
                <CheckBox Content="Ocultar duplicadas (A↔B)" IsChecked="{Binding Dedupe}" VerticalAlignment="Center" Margin="0,4,0,4"/>
            </WrapPanel>
        </Border>

        <!-- Barra: visualização + salvar/comparar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10"
                Visibility="{Binding HasMapped, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <!-- toggle Tabela/Diagrama -->
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Margin="0,4,18,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tabela" Command="{Binding ShowTableCommand}" Padding="14,6" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTable}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Diagrama" Command="{Binding ShowDiagramCommand}" Padding="14,6" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiagram}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- zoom (só no diagrama) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,18,4"
                            Visibility="{Binding IsDiagram, Converter={StaticResource BoolToVis}}">
                    <Button Content="–" Command="{Binding ZoomOutCommand}" Style="{StaticResource BtnGhost}" Width="34" Padding="0,4"/>
                    <Button Content="↺" Command="{Binding ZoomResetCommand}" Style="{StaticResource BtnGhost}" Width="34" Padding="0,4" Margin="6,0"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource BtnGhost}" Width="34" Padding="0,4"/>
                </StackPanel>

                <Button Content="Salvar topologia" Style="{StaticResource BtnSuccess}"
                        Command="{Binding SaveTopologyCommand}" Margin="0,4,8,4" MinWidth="150"/>
                <Button Content="Exportar Excel" Style="{StaticResource BtnGhost}"
                        Command="{Binding ExportExcelCommand}" Margin="0,4,18,4" MinWidth="130"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,8,4">
                    <TextBlock Text="Comparar com:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,8,0"/>
                    <ComboBox Width="240" VerticalAlignment="Center"
                              ItemsSource="{Binding SavedTopologies}" SelectedItem="{Binding SelectedComparison}"
                              ItemTemplate="{StaticResource DisplayItemTemplate}"/>
                </StackPanel>
                <Button Content="Comparar" Style="{StaticResource BtnPurple}" Command="{Binding CompareTopologyCommand}" Margin="0,4,6,4" MinWidth="110"/>
                <Button Content="Excluir" Style="{StaticResource BtnGhost}" Command="{Binding DeleteTopologyCommand}" Margin="0,4,0,4" MinWidth="80"/>
            </WrapPanel>
        </Border>

        <!-- Info + contagens -->
        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasMapped, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Pill}" Background="#E0EAFF" Padding="12,3" Margin="0,0,8,0">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB">
                            <Run Text="Ligações: "/><Run Text="{Binding LinkCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#DCFCE7" Padding="12,3">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#16A34A">
                            <Run Text="Com SNMP: "/><Run Text="{Binding DevicesAnswered, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DevicesScanned, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Lido por SNMP (LLDP-MIB) de cada device. Requer SNMP habilitado e o PC na mesma sub-rede. Switches não gerenciáveis não aparecem."/>
            </DockPanel>
        </Border>

        <!-- ===================== CONTEÚDO ===================== -->
        <Grid Grid.Row="4">

            <!-- TABELA -->
            <Grid Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Links}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding LocalDevice}" Width="1.7*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Porta local" Binding="{Binding LocalPort}" Width="1*" MinWidth="90"/>
                        <DataGridTextColumn Header="Vizinho" Binding="{Binding NeighborDevice}" Width="1.7*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Porta do vizinho" Binding="{Binding NeighborPort}" Width="1*" MinWidth="100"/>
                        <DataGridTextColumn Header="IP local" Binding="{Binding LocalIp}" Width="1.1*" MinWidth="100"/>
                        <DataGridTextColumn Header="MAC local" Binding="{Binding LocalMac}" Width="1.3*" MinWidth="130">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- DIAGRAMA -->
            <Border Visibility="{Binding IsDiagram, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Background="#FBFCFE">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4">
                    <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                        </Grid.LayoutTransform>

                        <!-- arestas (linhas) -->
                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                          Stroke="#94A3B8" StrokeThickness="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- rótulos de porta -->
                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"
                                            Padding="4,1" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><TranslateTransform X="-20" Y="-9"/></Border.RenderTransform>
                                        <TextBlock Text="{Binding PortLabel}" FontSize="9.5" Foreground="#64748B"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- nós (dispositivos) -->
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Thumb DragDelta="NodeThumb_DragDelta" Cursor="SizeAll">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="nb" Width="160" Height="50" CornerRadius="8"
                                                        Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="1.5">
                                                    <Border.Effect><DropShadowEffect Color="#334155" BlurRadius="8" ShadowDepth="1" Opacity="0.18"/></Border.Effect>
                                                    <TextBlock x:Name="nt" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="#1E293B" TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHub}" Value="True">
                                                        <Setter TargetName="nb" Property="Background" Value="{StaticResource Navy}"/>
                                                        <Setter TargetName="nb" Property="BorderBrush" Value="{StaticResource Navy}"/>
                                                        <Setter TargetName="nt" Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- COMPARAÇÃO -->
            <Grid Visibility="{Binding IsCompareView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompareResult.HasDivergences}" Value="True">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                    <Setter Property="BorderBrush" Value="#FED7AA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding CompareResult.ComparisonHeader}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CompareResult.Headline}" FontSize="14.5" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Style="{StaticResource Pill}" Background="#E0EAFF" Margin="0,0,8,0" Padding="12,3">
                                <TextBlock Foreground="#2563EB" FontWeight="SemiBold" FontSize="12">
                                    <Run Text="Cabo trocado: "/><Run Text="{Binding CompareResult.Changed, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#FDE8E8" Margin="0,0,8,0" Padding="12,3">
                                <TextBlock Foreground="#DC2626" FontWeight="SemiBold" FontSize="12">
                                    <Run Text="Sumiram: "/><Run Text="{Binding CompareResult.Removed, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#FEF3C7" Margin="0,0,8,0" Padding="12,3">
                                <TextBlock Foreground="#B45309" FontWeight="SemiBold" FontSize="12">
                                    <Run Text="Novas: "/><Run Text="{Binding CompareResult.Added, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#DCFCE7" Padding="12,3">
                                <TextBlock Foreground="#16A34A" FontWeight="SemiBold" FontSize="12">
                                    <Run Text="OK: "/><Run Text="{Binding CompareResult.Unchanged, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding CompareRows}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource CompareBg}}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Situação" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="White" Margin="4,0"
                                            BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource CompareAccent}}">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10.5"
                                                   Foreground="{Binding Status, Converter={StaticResource CompareAccent}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding LocalDevice}" Width="1.5*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Porta" Binding="{Binding LocalPort}" Width="0.8*" MinWidth="80"/>
                        <DataGridTextColumn Header="Era (referência)" Binding="{Binding RefNeighbor}" Width="1.4*" MinWidth="130"/>
                        <DataGridTextColumn Header="Agora" Binding="{Binding CurNeighbor}" Width="1.4*" MinWidth="130"/>
                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="2*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#334155"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
