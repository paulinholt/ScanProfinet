<UserControl x:Class="ScanProfinet.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Topologia da rede" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                       Text="Tabela de vizinhança (LLDP): quem está ligado em quem, porta a porta. Útil para detectar cabo trocado."/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Placa de rede" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                          ItemsSource="{Binding Interfaces}" SelectedIndex="{Binding SelectedInterfaceIndex}"
                          ItemTemplate="{StaticResource DisplayItemTemplate}" IsEnabled="{Binding IsNpcapAvailable}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Tempo de escuta" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>
                <ComboBox Grid.Row="0" Grid.Column="4" Width="92" VerticalAlignment="Center"
                          SelectedValuePath="Tag" SelectedValue="{Binding ScanSeconds}">
                    <ComboBoxItem Content="3 s" Tag="3"/>
                    <ComboBoxItem Content="5 s" Tag="5"/>
                    <ComboBoxItem Content="8 s" Tag="8"/>
                    <ComboBoxItem Content="12 s" Tag="12"/>
                </ComboBox>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Mapear topologia" Style="{StaticResource BtnPrimary}"
                            Command="{Binding MapCommand}" IsEnabled="{Binding IsNpcapAvailable}" MinWidth="170"/>
                    <CheckBox Content="Ocultar ligações duplicadas (A↔B)" IsChecked="{Binding Dedupe}"
                              VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info + contagens -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasMapped, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Pill}" Background="#E0EAFF" Padding="12,3" Margin="0,0,8,0">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB">
                            <Run Text="Ligações: "/><Run Text="{Binding LinkCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#DCFCE7" Padding="12,3">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#16A34A">
                            <Run Text="Com SNMP: "/><Run Text="{Binding DevicesAnswered, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DevicesScanned, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="A topologia é lida por SNMP (LLDP-MIB) de cada dispositivo. Requer SNMP habilitado nos devices e o PC na mesma sub-rede. Switches não gerenciáveis não aparecem (não falam LLDP)."/>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Filtrar:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtra por dispositivo, porta ou IP"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Links}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dispositivo" Binding="{Binding LocalDevice}" Width="1.7*" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Porta local" Binding="{Binding LocalPort}" Width="1*" MinWidth="90"/>
                    <DataGridTextColumn Header="" Width="Auto">
                        <DataGridTextColumn.Binding><Binding Source="→"/></DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vizinho" Binding="{Binding NeighborDevice}" Width="1.7*" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Porta do vizinho" Binding="{Binding NeighborPort}" Width="1*" MinWidth="100"/>
                    <DataGridTextColumn Header="IP local" Binding="{Binding LocalIp}" Width="1.1*" MinWidth="100"/>
                    <DataGridTextColumn Header="MAC local" Binding="{Binding LocalMac}" Width="1.3*" MinWidth="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
